{
  "name": "mcp-tools-snapshot-stats",
  "version": "0.1.0",
  "description": "Statistical analyzer for an MCP tools/list snapshot — tool count, schema depth, property totals, type distribution, missing descriptions, schema-less / empty-schema flags, required-field ratios. Companion to mcp-tools-snapshot, mcp-tools-diff, and mcp-tool-card-summary. Library + CLI.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/mcp-tools-snapshot-stats"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tools",
    "json-schema",
    "stats",
    "governance",
    "ai-governance",
    "typescript"
  ],
  "bin": {
    "mcp-tools-snapshot-stats": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/tools-list.json --format summary",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.7"
  }
}
